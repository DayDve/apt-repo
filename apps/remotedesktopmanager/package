SOURCE_URL="https://devolutions.net/remote-desktop-manager/"
DESCRIPTION="One application for every remote connection you'll ever open"
DEVELOPER="Devolutions"
APPSTREAM_TYPE="desktop-application"
APPSTREAM_CATEGORIES="Utility;Security;RemoteAccess"

check_update() {
  local current="${1:-}"
  local url version
  version=$(fetch_url https://devolutions.net/remote-desktop-manager/download/ \
    | grep -oP 'https://[^"]*Linux/[^"]*RemoteDesktopManager[^"]*amd64\.deb' \
    | grep -oP '\d{4}(\.\d){3}' | sort -V | tail -1)
  [ -n "$version" ] && [ "$version" != "$current" ]
}

get_version() {
  local current="${1:-}"
  version=$(fetch_url https://devolutions.net/remote-desktop-manager/download/ \
    | grep -oP 'https://[^"]*Linux/[^"]*RemoteDesktopManager[^"]*amd64\.deb' \
    | grep -oP '\d{4}(\.\d){3}' | sort -V | tail -1)

  fetch_url https://devolutions.net/remote-desktop-manager/release-notes/linux/ \
    | awk -v ver="$version" 'BEGIN{RS="<"}
    /^article.*data-rn-version="/{if($0~"data-rn-version=\""ver"\"") f=1}
    f && /^\/article/{exit}
    f{v=$0; sub(/^[^>]*>/,"",v); if(v~/scrollIntoView|getElementById|x-on:|event\.|document\./) next;
      gsub(/^[ \t\r\n]+|[ \t\r\n]+$/,"",v); if(v==""||v=="·") next;
      if(v~/^(Features|Improvements|Fixes|Requires|New features)$/){started=1; h=v; next}
      if(!started) next;
      if(h){print "## " h ": " v; h=""} else print " - " v}'
}
