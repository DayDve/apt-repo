SOURCE_URL="https://github.com/ilia-maslakov/mcdev"
DESCRIPTION="Midnight Commander with Plugins"
APPSTREAM_TYPE="desktop-application"
APPSTREAM_CATEGORIES="System;FileTools"
ICON_SOURCE="file"
ICON_PATH="icons/mc6.png"

# One upstream release builds three packages (mc6, mc6-data, mc6-plugins),
# all version-locked to the same tag; each app rebuilds the upstream Debian
# source package and ships its own deb. This package tracks the main binary.
check_update() {
  gh_latest_release ilia-maslakov/mcdev
  version="${LATEST_TAG#v}"
  [ "$version" != "${1:-}" ]
}

get_version() {
  local current="${1:-}" raw
  gh_latest_release ilia-maslakov/mcdev
  version="${LATEST_TAG#v}"
  raw=$(gh_release_body ilia-maslakov/mcdev)
  ai_changelog "mc6" "$raw" "the main binary (file manager, editor, viewer, embedded terminal, shell integration)"
}
