SOURCE_URL="https://github.com/rclone/rclone"
DESCRIPTION="rsync for cloud storage"
DEVELOPER="Nick Craig-Wood"
APPSTREAM_TYPE="console-application"
APPSTREAM_CATEGORIES="Utility;FileTransfer"
ICON_SOURCE="url"
ICON_PATH="https://raw.githubusercontent.com/rclone/rclone/master/graphics/logo/logo_on_light/logo_symbol_on_light_mono_256px.png"

check_update() {
  gh_latest_release rclone/rclone
  version="${LATEST_TAG#v}"
  [ "$version" != "${1:-}" ]
}

get_version() {
  local current="${1:-}"
  gh_latest_release rclone/rclone
  version="${LATEST_TAG#v}"

  echo "$RELEASE_BODY"
}
