SOURCE_URL="https://github.com/ilia-maslakov/mcdev"
DESCRIPTION="A Midnight Commander fork with an extensible plugin architecture for panels and editor, featuring built-in integrations for Docker, Kubernetes, S3, MongoDB, and Git."
APPSTREAM_TYPE="console-application"
APPSTREAM_CATEGORIES="System;FileTools"

check_update() {
  gh_tag_ahead ilia-maslakov/mcdev
  version="${LATEST_TAG#v}"
  [ "$version" != "${1:-}" ]
}

get_version() {
  local current="${1:-}"
  gh_tag_ahead ilia-maslakov/mcdev
  version="${LATEST_TAG#v}"
  local raw
  raw=$(gh_release_body ilia-maslakov/mcdev)
  ai_changelog "mc-ng" "$raw"
}
