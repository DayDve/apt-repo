SOURCE_URL="https://github.com/ilia-maslakov/mcdev"
DESCRIPTION="Heavily modified Midnight Commander fork with plugins, arcmc, and more"

check_update() {
  gh_tag_ahead ilia-maslakov/mcdev
  version="${LATEST_TAG#v}"
  [ "$version" != "${1:-}" ]
}

get_version() {
  local current="${1:-}"
  gh_tag_ahead ilia-maslakov/mcdev
  version="${LATEST_TAG#v}"
  gh_release_body ilia-maslakov/mcdev
}
