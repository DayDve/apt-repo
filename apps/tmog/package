# ============================================================
# Package script for tmog
# ============================================================

SOURCE_URL="https://tmog.org"
DESCRIPTION="Native Qt 6 system monitor and task manager by the author of the original Windows Task Manager"
DEVELOPER="Plummer's Software LLC"
# Display name on the site / KDE Discover / Telegram (dir name is only an internal id).
APP_NAME="TMOG"
APPSTREAM_TYPE="desktop-application"
APPSTREAM_CATEGORIES="System;Monitor"
APPSTREAM_KEYWORDS="task manager,system monitor,processes,performance,cpu,memory"
APPSTREAM_SUMMARY="Native system monitor and task manager"

_tmog_deb_url() {
  fetch_url "https://tmog.org" | grep -oP 'href="\K[^"]+\.deb' | head -1
}

# Version is derived from the .deb download href (not version.txt),
# because the page can advertise a version before the file is uploaded.
# A HEAD check ensures we never claim a version we can't actually ship.
_tmog_version() {
  local url
  url=$(_tmog_deb_url) || return 1
  local v
  v=$(grep -oP '\d+\.\d+\.\d+' <<<"${url}") || return 1
  # Verify the deb is actually downloadable (upstream sometimes updates
  # the page before uploading the file).
  local code
  code=$(curl -sIL -o /dev/null -w '%{http_code}' "https://tmog.org${url}" 2>/dev/null) || code=000
  [[ "$code" == "200" ]] || { echo "tmog: $url returned HTTP $code, treating as no update" >&2; return 1; }
  echo "$v"
}

# check_update_safe validates the GLOBAL $version after this runs, so it
# must be set here (no `local`).
check_update() {
  local current="${1:-}"
  version=$(_tmog_version) || { echo "tmog: failed to detect version"; return 1; }
  [ "$version" != "$current" ]
}

get_version() {
  version=$(_tmog_version) || { echo "Failed to parse version"; return 1; }
  local rn
  rn=$(fetch_url "https://www.tmog.org/release-notes.html" 2>/dev/null || true)
  if [ -n "$rn" ]; then
    # Release notes are a short prose summary followed by bullet lists.
    # Strip markup; a missing grep match must not abort the build (set -e),
    # so every extractor is guarded with || true.
    echo "$rn" | sed -e 's/<[^>]*>/ /g' -e 's/&nbsp;/ /g' | tr -s '[:space:]' ' ' \
      | grep -ioP 'TMOG brings[^.]*\.' || true
    echo "$rn" | grep -oP '<li>\K[^<]+(?=</li>)' | sed 's/^[[:space:]]*/ - /' || true
  else
    echo "Task Manager TMOG ${version}"
  fi
  echo
  echo "Release notes: https://www.tmog.org/release-notes.html"
}