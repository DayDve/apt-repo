# ============================================================
# Package script for bitwarden (desktop app)
# ============================================================

SOURCE_URL="https://github.com/bitwarden/clients"
DESCRIPTION="Open source password manager (desktop app)"
APP_NAME="Bitwarden"
DEVELOPER="Bitwarden Inc."
LICENSE="GPL-3.0-only"
APPSTREAM_TYPE="desktop-application"
APPSTREAM_CATEGORIES="Utility;Security"
APPSTREAM_KEYWORDS="password,manager,vault,security"
CHANGELOG_URL="https://github.com/bitwarden/clients/releases"

# bitwarden/clients is a monorepo: releases are tagged desktop-v*, browser-v*,
# cli-v*, web-v*, plus occasional *-beta.N prereleases. Pick the newest
# stable desktop release.
_bitwarden_latest() {
  local json
  json=$(gh_api_retry "repos/bitwarden/clients/releases?per_page=50") || {
    LATEST_TAG="unknown"; RELEASE_BODY=""; return 1; }
  LATEST_TAG=$(printf '%s' "$json" | jq -r \
    '[.[] | select((.tag_name | startswith("desktop-v")) and (.prerelease | not) and (.draft | not))][0].tag_name // "unknown"')
  RELEASE_BODY=$(printf '%s' "$json" | jq -r --arg t "$LATEST_TAG" \
    '.[] | select(.tag_name == $t) | .body' | sed -e 's/\r$//' -e '/^<!--.*-->$/d')
}

check_update() {
  _bitwarden_latest
  version="${LATEST_TAG#desktop-v}"
  [ "$version" != "${1:-}" ]
}

get_version() {
  _bitwarden_latest
  version="${LATEST_TAG#desktop-v}"
  echo "$RELEASE_BODY"
}
