SOURCE_URL="https://gitlab.com/gitlab-org/cli"
DESCRIPTION="Official GitLab command-line tool"
CHANGELOG_URL="https://gitlab.com/gitlab-org/cli/-/releases"

check_update() {
  local current="${1:-}" tag
  tag=$(fetch_url "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases?per_page=1" 2>/dev/null \
    | jq -r '.[0].tag_name // empty')
  [ -z "$tag" ] && return 1
  version="${tag#v}"
  [ "$version" != "$current" ]
}

get_version() {
  local json
  json=$(fetch_url "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases?per_page=1" 2>/dev/null)
  version=$(printf '%s' "$json" | jq -r '.[0].tag_name // empty' | sed 's/^v//')
  [ -z "$version" ] && return 1
  printf '%s' "$json" | jq -r '.[0].description'
}
