SOURCE_URL="https://github.com/ilia-maslakov/mcdev"
DESCRIPTION="Midnight Commander with Plugins — data files"
DEVELOPER="Ilia Maslakov"
APPSTREAM_TYPE="none"
# Share the Telegram notification with the main package (one combined message).
FAMILY="mc6"
# Display grouping: all mc6 packages shown as one entry on the site/README.
GROUP="mc6"

# Architecture-independent data for mc6. Version-locked to the same upstream
# tag as mc6 / mc6-plugins; never build it alone or mc6's strict
# "mc6-data (= <version>)" dependency breaks.
check_update() {
  gh_latest_release ilia-maslakov/mcdev
  version="${LATEST_TAG#v}"
  [ "$version" != "${1:-}" ]
}

get_version() {
  local current="${1:-}" raw
  gh_latest_release ilia-maslakov/mcdev
  version="${LATEST_TAG#v}"
  raw=$(gh_release_body ilia-maslakov/mcdev)
  ai_changelog "mc6-data" "$raw" "architecture-independent data files (icons, skins, syntax highlighting, help, translations)"
}
