# ============================================================
# Package script for winegui
# ============================================================

SOURCE_URL="https://github.com/winegui/WineGUI"
DESCRIPTION="Wine prefix manager with a modern GUI"
APPSTREAM_TYPE="desktop-application"
APPSTREAM_CATEGORIES="System;Emulator"

check_update() {
  gh_latest_release winegui/WineGUI
  version="${LATEST_TAG#v}"
  [ "$version" != "${1:-}" ]
}

get_version() {
  gh_latest_release winegui/WineGUI
  version="${LATEST_TAG#v}"
  local current="${1:-}" releases_url="https://gitlab.melroy.org/melroy/winegui/-/releases" raw
  # gitlab.melroy.org sits behind an anti-bot challenge (HTTP and git both 403),
  # so changelog comes from commits between tags on the GitHub mirror.
  if [ -n "$current" ]; then
    raw=$(gh_commits_between winegui/WineGUI "v$current" "$LATEST_TAG")
    if [ -n "$raw" ]; then
      ai_changelog "winegui" "$raw"
      return
    fi
  fi
  printf '%s' "${RELEASE_BODY:-Подробный лог: $releases_url}"
}
